# Copie este arquivo com o nome .env e cole suas chaves depois do sinal de igual.

# Chave da Anthropic (console.anthropic.com > API Keys). Começa com sk-ant-
ANTHROPIC_API_KEY=

# Chave e região do Azure Speech (portal.azure.com > seu recurso Speech > Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Modelo da IA: claude-haiku-5-5 (mais barato), claude-sonnet-5-5 ou claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Senha do site (use quando publicar na internet; deixe vazio no seu computador)
APP_PASSWORD=
